<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No console window: the app lives in the notification area (Ui/TrayApp.cs); everything printed goes to d4assist-log.txt. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The tray icon and the settings window: native Win32 controls, which screen readers read without extra work. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>D4Assist</RootNamespace>
    <!-- Logged at start (with the commit): a tester's log tells which build it came from. -->
    <Version>0.1.17</Version>
    <!-- Needed so restore/build copies Prismatoid's bundled win-x64 prism.dll (runtimes/win-x64/native) to
         the output dir — see reference/screen-reader-integration/prism-prebuilt.md (no x86 PRISM build exists). -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms' implicit global usings would clash with game-side names (Timer, Message, Point); UI files import them. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Official .NET PRISM binding (targets .NET 10) — see reference/screen-reader-integration/prism-prebuilt.md. -->
    <PackageReference Include="Prismatoid" Version="0.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\D4Data\D4Data.csproj" />
    <ProjectReference Include="..\D4Memory\D4Memory.csproj" />
    <ProjectReference Include="..\D4Assist.Navigation\D4Assist.Navigation.csproj" />
    <ProjectReference Include="..\D4Assist.Audio\D4Assist.Audio.csproj" />
    <ProjectReference Include="..\D4Assist.Radar\D4Assist.Radar.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The starting config, in the portable build only: a build must never overwrite the config a player saved (it did
         on 2026-10-01). Without the file the app starts from the same defaults (Config/AppConfig.cs). -->
    <None Update="d4assist.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <!-- d4data type registry (data/ is not in git: see README "Setup"), embedded in the exe: the default when DefinitionsPath is empty. -->
    <EmbeddedResource Include="..\..\data\definitions.json" LogicalName="definitions.json" Condition="Exists('..\..\data\definitions.json')" />
    <!-- d4data's buildVersion.txt beside it, for the log only: it names d4data's latest build, not the one definitions.json was dumped from. -->
    <EmbeddedResource Include="..\..\data\buildVersion.txt" LogicalName="definitions-build.txt" Condition="Exists('..\..\data\buildVersion.txt')" />
  </ItemGroup>

  <ItemGroup>
    <!-- The players' readme: in the portable build only (Properties/PublishProfiles/Portable.pubxml). -->
    <None Include="Portable\README.txt" Link="README.txt" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Prismatoid also ships tolk.dll, an optional Tolk-compat backend: NVDA, JAWS and SAPI are built into prism.dll
       (CLAUDE.md §4), so the portable build leaves it out. -->
  <Target Name="DropTolkFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'tolk.dll'" />
    </ItemGroup>
  </Target>

</Project>
