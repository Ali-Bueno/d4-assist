<?xml version="1.0" encoding="utf-8"?>
<!-- The testers' portable build: `dotnet publish src/D4Assist -p:PublishProfile=Portable`.
     One self-contained D4Assist.exe (the .NET runtime, every managed assembly with the embedded sounds and
     definitions.json, and prism.dll inside it) next to d4assist.json and README.txt, instead of ~200 loose files. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- prism.dll too: extracted once to %TEMP%\.net\D4Assist\ on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Symbols inside the exe, so crash stack traces keep line numbers without shipping .pdb files. -->
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\D4Assist\</PublishDir>
  </PropertyGroup>
</Project>
