<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>D4Assist.Audio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Inside the assembly, so the portable folder carries no loose sound files (SpatialLoopPlayer.LoadSounds). -->
    <EmbeddedResource Include="Sounds\*.wav" LogicalName="Sounds/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Radar cue audio: BCL only, WinMM waveOut* via P/Invoke (see README.md). No game or process access. -->

</Project>
