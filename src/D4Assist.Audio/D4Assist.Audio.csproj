<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>D4Assist.Audio</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Sounds\*.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Radar cue audio: BCL only, WinMM waveOut* via P/Invoke (see README.md). No game or process access. -->

</Project>
